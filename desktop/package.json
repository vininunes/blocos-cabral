{
  "name": "blocos-cabral-relatorio",
  "productName": "Relatorio Blocos Cabral",
  "author": "Vinicius Nunes Cabral de Souza <viniciusnunes1709@gmail.com>",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "description": "Relatório de Operações da Blocos Cabral (exports do Bling → painel, PowerPoint e Excel).",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "predev": "node scripts/check-vendor.mjs",
    "dev": "vite",
    "electron:dev": "node scripts/check-vendor.mjs && node scripts/electron-dev.mjs",
    "build:web": "node scripts/check-vendor.mjs && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "yarn build:web && yarn build:electron && electron .",
    "pack": "yarn build:web && yarn build:electron && electron-builder --dir",
    "dist": "yarn build:web && yarn build:electron && electron-builder",
    "dist:mac": "yarn build:web && yarn build:electron && electron-builder --mac --arm64 --x64",
    "dist:win": "yarn build:web && yarn build:electron && electron-builder --win --x64",
    "typecheck": "node scripts/check-vendor.mjs && tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
